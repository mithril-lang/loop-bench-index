(ns terminal-bench.mithril-server
  "Resident Mithril helper: one process per agent, one JSON request per stdin
  line, one JSON response per stdout line. It answers the same operations as
  mithril-bpmn-step.cljk (enabled / select / complete) and
  mithril-task-state.cljk (task-state) with the same logic, but loads the
  namespaces once and caches compiled profiles and ontologies per file
  modification time. harness/tests/test_mithril_server.py checks response
  parity with the two CLI scripts on the same inputs."
  (:require [cljs.reader :as reader]
            [clojure.string :as str]
            [mithril.bpmn :as bpmn]
            [mithril.compiler :as compiler]
            [mithril.execution :as execution]
            [mithril.state-ontology :as state-ontology]
            [mithril.state-rdf :as state-rdf]
            [oak.semantic :as oak]))

(def fs (js/require "node:fs"))
(def path-api (js/require "node:path"))
(def readline (js/require "node:readline"))

(defn read-text [path] (.readFileSync fs path "utf8"))
(defn mtime [path] (.-mtimeMs (.statSync fs path)))
(defn read-json [path] (js->clj (.parse js/JSON (read-text path))))

(def cache (atom {}))
(defn cached [kind path f]
  (let [k [kind path (mtime path)]]
    (or (get @cache k)
        (let [v (f)] (swap! cache assoc k v) v))))

(defn compile-ontology [path]
  (cached :ontology path #(compiler/compile-ontology-text path (read-text path))))

;; ---- BPMN step (same logic as mithril-bpmn-step.cljk) ----------------------
(def action-root "https://mithril.fund/id/action/terminal/")
(def class-root "https://mithril.fund/id/class/")
(def proposed-class (str class-root "ProposedAction"))
(def action-shape
  {:shacl/type :node-shape
   :target-class :mithril/ProposedAction
   :property [{:path :actionKind :datatype :string :min-count 1 :max-count 1}
              {:path :commandText :datatype :string :min-count 1 :max-count 1}]})

(defn persist! [path runtime]
  (.writeFileSync fs path (pr-str (select-keys runtime [:token-state :pending :semantic-receipts]))))

(defn semantic-check! [ontology action-id command]
  (let [kind (str/replace action-id action-root "")
        class-id (str class-root (str/capitalize kind) "Action")
        nodes (get-in ontology [:rdf-dataset "@graph"])
        classes (into {} (map (juxt #(get % "@id") identity)) nodes)
        parent (get-in classes [class-id "subClassOf"])
        proposal {:actionKind action-id :commandText command}
        report (execution/validate-shape action-shape proposal)
        axioms (set (for [node nodes :when (get node "subClassOf")]
                      (oak/triple (get node "@id") :rdfs/subClassOf (get node "subClassOf"))))
        triples (conj axioms (oak/triple action-id :rdf/type class-id))
        inferred (oak/materialize :owl2-rl triples)
        expected (oak/triple action-id :rdf/type proposed-class)
        rows (oak/execute :owl2-rl
                          [:sparql/project [:?candidate]
                           [:sparql/bgp [:?candidate :rdf/type proposed-class]]]
                          triples)]
    (when-not (and (= parent proposed-class) (:valid? report)
                   (contains? inferred expected)
                   (seq rows))
      (throw (ex-info "ontology did not admit proposed action"
                      {:mithril/error :terminal-bench/semantic-refusal
                       :action action-id :shape-report report})))
    {:operation "infer/owl2-rl+query/sparql+validate/shacl"
     :action action-id :entailed true :query-rows (count rows)
     :shape-violations (count (:errors report))}))

(defn process-for [profile-path]
  (cached :process profile-path
          (fn []
            (let [profile (compiler/parse-source (read-text profile-path))
                  ontology-path (.join path-api (.dirname path-api profile-path) "terminal-actions-v2.mith")
                  ontology (compile-ontology ontology-path)
                  ontology-digest (str/replace (:graph-digest ontology) "sha256:" "")
                  _ (when-not (= ontology-digest (get profile "ontology"))
                      (throw (ex-info "ontology/profile digest mismatch"
                                      {:mithril/error :terminal-bench/ontology-digest-mismatch})))
                  action-ids (get-in profile ["policy" "actions"])
                  action-by-id (into {} (map (fn [id] [id {:id id}]) action-ids))]
              {:ontology ontology
               :process (bpmn/compile-process (get profile "process") action-by-id action-ids false)}))))

(defn bpmn-step [[profile-path state-path operation action-id outcome]]
  (let [{:keys [ontology process]} (process-for profile-path)
        start (bpmn/start-state process)
        prior (when (.existsSync fs state-path) (reader/read-string (read-text state-path)))
        runtime (if prior (merge start prior) start)]
    (case operation
      "enabled" {:actions (bpmn/enabled-action-ids runtime) :completed (bpmn/completed? runtime)}
      "select" (let [semantic (semantic-check! ontology action-id outcome)
                     selected (-> (bpmn/select-action runtime action-id)
                                  (update :semantic-receipts (fnil conj []) semantic))]
                 (persist! state-path selected)
                 {:pending action-id :enabled (bpmn/enabled-action-ids selected) :semantic semantic})
      "complete" (let [completed (bpmn/apply-outcome runtime action-id (= "true" outcome))]
                   (persist! state-path completed)
                   {:enabled (bpmn/enabled-action-ids completed) :completed (bpmn/completed? completed)})
      (throw (ex-info "unknown operation" {:operation operation})))))

;; ---- task state (same logic as mithril-task-state.cljk) --------------------
(def root "https://mithril.fund/id/class/")

(defn task-state [[state-path document-path ontology-path schema-path]]
  (let [state (read-json state-path)
        document (state-rdf/document state)
        decoded (state-rdf/decode-document! document)
        _ (when-not (= state decoded) (throw (ex-info "state roundtrip mismatch" {})))
        schema (cached :schema schema-path #(state-ontology/schema (read-text schema-path)))
        report (state-ontology/validate! schema (state-rdf/quads document))
        _ (when-not (:valid? report) (throw (ex-info "state SHACL violation" report)))
        ontology (compile-ontology ontology-path)
        classes (filter #(= "owl:Class" (get % "@type")) (get-in ontology [:rdf-dataset "@graph"]))
        axioms (set (for [c classes :when (get c "subClassOf")]
                      (oak/triple (get c "@id") :rdfs/subClassOf (get c "subClassOf"))))
        phase (get state "phase")
        subject "https://mithril.fund/id/task/current"
        asserted (case phase
                   "hypothesize" (str root "HypothesisState")
                   "experiment" (str root "ExperimentState")
                   "reflect" (str root "ReflectionState")
                   "verify" (str root "VerificationState")
                   "complete" (str root "CompleteState")
                   (throw (ex-info "invalid task phase" {:phase phase})))
        inferred (oak/materialize :owl2-rl (conj axioms (oak/triple subject :rdf/type asserted)))
        entailed? (contains? inferred (oak/triple subject :rdf/type (str root "ResearchState")))
        _ (when-not entailed? (throw (ex-info "task class not entailed" {:phase phase})))
        observed (vec (take 24 (get state "domain_observed_classes" [])))
        focus (vec (take 12 (get state "domain_focus_classes" [])))
        domain-entailed
        (into {}
              (for [observed-class observed
                    :let [evidence-subject (str "https://mithril.fund/id/evidence/" (js/encodeURIComponent observed-class))
                          closure (oak/materialize :owl2-rl
                                                   (conj axioms (oak/triple evidence-subject :rdf/type observed-class)))]]
                [observed-class
                 (vec (filter #(contains? closure (oak/triple evidence-subject :rdf/type %)) focus))]))
        digest (state-rdf/graph-digest document)]
    (.writeFileSync fs document-path (.stringify js/JSON (clj->js document)))
    {:codec "mithril.state-rdf/document+decode-document!"
     :state-graph-digest digest :state-graph-nodes (count (get document "@graph"))
     :owl-profile "owl2-rl" :task-state-entailed entailed?
     :domain-entailed domain-entailed :domain-observed-count (count observed)
     :shacl-valid (:valid? report) :checked-nodes (:checked-nodes report)
     :phase phase}))

;; ---- line protocol ---------------------------------------------------------
(defn handle [line]
  (let [request (js->clj (.parse js/JSON line))
        id (get request "id")]
    (try
      (let [result (case (get request "op")
                     "bpmn" (bpmn-step (get request "args"))
                     "task-state" (task-state (get request "args"))
                     (throw (ex-info "unknown op" {:op (get request "op")})))]
        {:id id :ok true :result result})
      (catch :default e
        {:id id :ok false
         :result {:error (or (.-message e) (str e))
                  :code (some-> e .-data (aget "mithril/error") str)}}))))

(let [rl (.createInterface readline #js {:input (.-stdin js/process) :terminal false})]
  (println (.stringify js/JSON (clj->js {:ready true})))
  (.on rl "line" (fn [line]
                   (when-not (str/blank? line)
                     (println (.stringify js/JSON (clj->js (handle line))))))))
