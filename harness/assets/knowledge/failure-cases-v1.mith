(mithril/ontology
  :id "https://mithril.fund/id/ontology/failure-cases-v1"
  :profile ["https://www.w3.org/TR/rdf11-concepts/" "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" "https://www.w3.org/TR/shacl/"]
  :graph
  [(owl/class :id "https://mithril.fund/id/failure/FailureCase")
   (owl/class :id "https://mithril.fund/id/failure/ObservedFailure" :rdfs/sub-class-of "https://mithril.fund/id/failure/FailureCase")
   (owl/class :id "https://mithril.fund/id/failure/AnticipatedFailure" :rdfs/sub-class-of "https://mithril.fund/id/failure/FailureCase")
   (owl/class :id "https://mithril.fund/id/failure/AgentProcessFailure" :rdfs/sub-class-of "https://mithril.fund/id/failure/FailureCase")
   (owl/class :id "https://mithril.fund/id/failure/InterpretationFailure" :rdfs/sub-class-of "https://mithril.fund/id/failure/FailureCase")
   (rdf/node :id "https://mithril.fund/id/failure/fc-01-plan-in-one-reply" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (results/lane-comparison-railmini-d3-2026-09-25): a reply that wrote a whole multi-step plan ended with finish, so nothing was executed and every output file was missing. Remedy: return one action per reply and finish only after listing the required files.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-02-correlated-self-check" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (results/harness-judge-a-2026-09-25): an independent recomputation written under the same reading of the task agreed with a wrong answer. Remedy: check each stated rule on a boundary case separately instead of trusting agreement between two versions of the same logic.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-03-identity-split" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (railmini identity trap, Terminal-Bench physical-point identity): one entity appeared under several identifiers and was counted as several. Remedy: normalize identity first, then join and count.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-04-boundary-comparison" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (railmini validity boundary trap): a strict comparison dropped the boundary day that the task says counts. Remedy: use the comparison the text states (on or after, at least, at most).")
   (rdf/node :id "https://mithril.fund/id/failure/fc-05-inspection-loop" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (Terminal-Bench v4/v6, mithril lane at the step cap): many consecutive inspections used the step budget and the task ended unfinished. Remedy: write a first complete solution early, run it, then refine from its output.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-06-input-scope" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (results/harness-auto-acceptance-2026-09-25): a file present in the directory but not named as an input was treated as input. Remedy: read exactly the inputs the task names.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-07-unit-normalization" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (railmini voltage trap, Terminal-Bench qualification query): values with mixed units were compared without converting. Remedy: parse the unit and convert before comparing with a threshold.")
   (rdf/node :id "https://mithril.fund/id/failure/fc-08-long-reply" :rdf/type "https://mithril.fund/id/failure/ObservedFailure" :text "Observed (runaway generation to the output limit): very long single replies stalled the run. Remedy: keep each reply to one action; put long code in a file written by that action.")
   (rdf/node :id "https://mithril.fund/id/failure/fa-01-off-by-one" :rdf/type "https://mithril.fund/id/failure/AnticipatedFailure" :text "Anticipated, not yet observed on this family: counting nodes instead of edges, or excluding distance K, shifts every hop count or drops the boundary rows.")
   (rdf/node :id "https://mithril.fund/id/failure/fa-02-dfs-distance" :rdf/type "https://mithril.fund/id/failure/AnticipatedFailure" :text "Anticipated: recording the first distance found by depth-first search overstates minimum hops.")
   (rdf/node :id "https://mithril.fund/id/failure/fa-03-deny-ignored" :rdf/type "https://mithril.fund/id/failure/AnticipatedFailure" :text "Anticipated: adding every allow edge and ignoring deny rules overstates reachable stores.")
   (rdf/node :id "https://mithril.fund/id/failure/fa-04-kind-collision" :rdf/type "https://mithril.fund/id/failure/AnticipatedFailure" :text "Anticipated: keying graph nodes by name only merges a host and a role that share a name.")])
