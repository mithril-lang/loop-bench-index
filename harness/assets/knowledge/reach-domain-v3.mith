(mithril/ontology
  :id "https://mithril.fund/id/ontology/reach-domain-v3"
  :profile ["https://www.w3.org/TR/rdf11-concepts/" "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" "https://www.w3.org/TR/shacl/"]
  :graph
  [(owl/class :id "https://mithril.fund/id/reach/ReachNode")
   (owl/class :id "https://mithril.fund/id/reach/HostNode" :rdfs/sub-class-of "https://mithril.fund/id/reach/ReachNode")
   (owl/class :id "https://mithril.fund/id/reach/RoleNode" :rdfs/sub-class-of "https://mithril.fund/id/reach/ReachNode")
   (owl/class :id "https://mithril.fund/id/reach/StoreNode" :rdfs/sub-class-of "https://mithril.fund/id/reach/ReachNode")
   (owl/class :id "https://mithril.fund/id/reach/EntryNode" :rdfs/sub-class-of "https://mithril.fund/id/reach/HostNode")
   (owl/class :id "https://mithril.fund/id/reach/KnowledgeRule")
   (owl/class :id "https://mithril.fund/id/reach/AlgorithmRule" :rdfs/sub-class-of "https://mithril.fund/id/reach/KnowledgeRule")
   (owl/class :id "https://mithril.fund/id/reach/PolicyRule" :rdfs/sub-class-of "https://mithril.fund/id/reach/KnowledgeRule")
   (owl/class :id "https://mithril.fund/id/reach/DataRule" :rdfs/sub-class-of "https://mithril.fund/id/reach/KnowledgeRule")
   (owl/class :id "https://mithril.fund/id/reach/CheckRule" :rdfs/sub-class-of "https://mithril.fund/id/reach/KnowledgeRule")
   (owl/object-property :id "https://mithril.fund/id/reach/step" :rdfs/domain "https://mithril.fund/id/reach/ReachNode" :rdfs/range "https://mithril.fund/id/reach/ReachNode")
   (owl/object-property :id "https://mithril.fund/id/reach/hostStep" :rdfs/sub-property-of "https://mithril.fund/id/reach/step")
   (owl/object-property :id "https://mithril.fund/id/reach/roleStep" :rdfs/sub-property-of "https://mithril.fund/id/reach/step")
   (owl/object-property :id "https://mithril.fund/id/reach/readStep" :rdfs/sub-property-of "https://mithril.fund/id/reach/step")
   (rdf/node :id "https://mithril.fund/id/reach/rule/bfs" :rdf/type "https://mithril.fund/id/reach/AlgorithmRule" :text "Fewest hops in an unweighted graph is breadth-first search from each entry. Depth-first search does not give minimum hops. Distance counts edges: the entry itself is 0.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/limit" :rdf/type "https://mithril.fund/id/reach/AlgorithmRule" :text "A hop limit stated as at most K is inclusive: keep distance K, drop K+1. Apply the limit to the minimum distance, not to any path.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/visited" :rdf/type "https://mithril.fund/id/reach/AlgorithmRule" :text "Graphs can contain cycles. Keep a visited set; an unbounded traversal without one does not terminate or overcounts.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/blast" :rdf/type "https://mithril.fund/id/reach/AlgorithmRule" :text "Reachable-set counts are over distinct entities of each kind, including the start node when the task says so, with no hop limit unless stated.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/typed-edges" :rdf/type "https://mithril.fund/id/reach/DataRule" :text "Build one adjacency map from every allowed move type before searching: host to host, host to role, role to role through a delegation, role to store. Node keys must include the kind, so a host and a role with the same name stay distinct.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/deny" :rdf/type "https://mithril.fund/id/reach/PolicyRule" :text "An explicit deny for the same principal and resource removes the allow. Evaluate per (principal, resource) pair before adding the edge.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/validity" :rdf/type "https://mithril.fund/id/reach/PolicyRule" :text "A time-limited grant counts only when its end date is on or after the stated current date. Compare as dates; the boundary day counts.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/identity" :rdf/type "https://mithril.fund/id/reach/DataRule" :text "Different sources can use different IRIs and spellings for one entity. Before joining, establish from the data which source is authoritative for names and how other sources refer to it (a stated normalization, or alias values); never join by IRI across sources.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/subclass" :rdf/type "https://mithril.fund/id/reach/DataRule" :text "Select nodes by class including subclasses declared in the ontology file.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/boundary-tests" :rdf/type "https://mithril.fund/id/reach/CheckRule" :text "Check the edge cases the rules name: a store at exactly K hops, a grant ending on the current date, a denied pair that is also allowed, two spellings of one name. Print the rows these cases produce and confirm each against the rule text.")
   (rdf/node :id "https://mithril.fund/id/reach/rule/invariants" :rdf/type "https://mithril.fund/id/reach/CheckRule" :text "Cheap invariants: every minHops is between 1 and K; every entry host appears in the reachable-set file; a store in the paths file is also counted in that entry's reachable stores; output is sorted and has no header.")   (rdf/node :id "https://mithril.fund/id/reach/rule/read-definitions" :rdf/type "https://mithril.fund/id/reach/DataRule" :text "Rules may be defined outside the task text: rdfs:comment annotations in the ontology file state what a property means, and data values (a reference date, a list of aliases) parameterize those rules. Read the ontology and the data definitions before writing the solver.")])
