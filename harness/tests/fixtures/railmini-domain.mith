(mithril/ontology :id "https://mithril.fund/id/ontology/terminal-task-domain-v1" :profile ["https://www.w3.org/TR/rdf11-concepts/" "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" "https://www.w3.org/TR/shacl/"] :graph [
(owl/class :id "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/class/HypothesisState" :rdfs/sub-class-of "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/class/ExperimentState" :rdfs/sub-class-of "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/class/ReflectionState" :rdfs/sub-class-of "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/class/VerificationState" :rdfs/sub-class-of "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/class/CompleteState" :rdfs/sub-class-of "https://mithril.fund/id/class/ResearchState")
(owl/class :id "https://mithril.fund/id/terminal-domain/TaskGoal")
(owl/class :id "https://mithril.fund/id/terminal-domain/TaskConstraint")
(owl/class :id "https://mithril.fund/id/terminal-domain/TaskHypothesis")
(owl/class :id "https://mithril.fund/id/terminal-domain/TaskEvidence")
(owl/class :id "http://example.org/rail#BorderPoint")
(owl/class :id "http://example.org/rail#OperationalPoint")
(owl/class :id "http://example.org/rail#SectionAuthorisation")
(owl/class :id "http://example.org/rail#SectionOfLine")
(owl/class :id "http://example.org/rail#Submission")
(owl/class :id "http://example.org/rail#BorderPoint" :rdfs/sub-class-of "http://example.org/rail#OperationalPoint")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/0" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Create /app/pipeline.py, /app/cross_border_points.rq, /app/qualified_points.rq, and /app/requirements.txt.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/1" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Make the pipeline accept exactly one target-directory argument, read the four named ontology files and every submission .ttl file there, and write unified.ttl into that directory.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/2" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Preserve every source RDF triple in unified.ttl; add only triples supported by source data and using ontology-defined or source-used classes and properties.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/3" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Make cross_border_points.rq run directly over unified.ttl and return one sorted row per physical operational point reported by at least two distinct countries, with exactly pointId, latitude, longitude, countryCount, and adjacentSectionCount.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/4" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Make qualified_points.rq run directly over unified.ttl and return one sorted row per physical cross-border operational point with at least one qualifying adjacent section, with exactly pointId, qualifyingSectionCount, vehicleCount, and maxVoltageKv.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskGoal/5" :rdf/type "https://mithril.fund/id/terminal-domain/TaskGoal" :text "Handle normalized identifiers, latest available coordinates, coordinateText coordinates, country and adjacent-section distinct counts, valid authorisations, and voltage conversion according to the task rules.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/0" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Do not modify source files or rely on reasoning or Python-side helpers when running either query.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/1" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Physical-point identity uses rl:opId normalized by removing spaces and hyphens and ignoring case; output identifiers are uppercase with spaces and hyphens removed.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/2" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Treat rl:BorderPoint records as operational-point records.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/3" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "For conflicting coordinates, use those from the record with the latest submission rl:issued date among records with coordinates; if none have coordinates, return -200.0 for both coordinates.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/4" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Coordinates may be supplied by rl:lat and rl:long or by rl:coordinateText in POINT(longitude latitude) form.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/5" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Count distinct rl:inCountry values and distinct rl:SectionOfLine resources connected through rl:startsAt or rl:endsAt.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/6" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Treat an authorisation as valid when rl:validUntil is on or after 2031-06-30; nominal voltage is text in kV or V, and qualifying voltage is at least 15 kV.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskConstraint/7" :rdf/type "https://mithril.fund/id/terminal-domain/TaskConstraint" :text "Use exactly the specified query columns and sort both query results by pointId.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskHypothesis/0" :rdf/type "https://mithril.fund/id/terminal-domain/TaskHypothesis" :text "Operational-point records identify their reported point with rl:opId and country with rl:inCountry.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskHypothesis/1" :rdf/type "https://mithril.fund/id/terminal-domain/TaskHypothesis" :text "A point's submission date can be obtained by following rl:submittedIn to a resource with rl:issued.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskHypothesis/2" :rdf/type "https://mithril.fund/id/terminal-domain/TaskHypothesis" :text "Section adjacency is represented by rl:startsAt and rl:endsAt links to operational-point records.")
(rdf/node :id "https://mithril.fund/id/terminal-domain/TaskHypothesis/3" :rdf/type "https://mithril.fund/id/terminal-domain/TaskHypothesis" :text "Section authorisations link a vehicle and section through rl:vehicle and rl:forSection and carry an rl:validUntil date.")
])